# Copy to .env and fill in real values. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=3000
# Trust the X-Forwarded-* headers set by Caddy (needed for correct client IPs / rate limiting)
TRUST_PROXY=true

# --- Database ---
# POSTGRES_USER owns the schema and is used ONLY to run migrations (db/migrate.js).
# The running app never connects as this user.
POSTGRES_USER=event_app_owner
POSTGRES_PASSWORD=change_me_long_random
POSTGRES_DB=annual_event

# app_runtime is a restricted role created by migration 001 with least-privilege
# grants (e.g. INSERT/SELECT only on audit_log, no UPDATE/DELETE, for tamper resistance).
# The app connects as this user at request time.
APP_DB_PASSWORD=change_me_long_random_2

# Host is the docker-compose service name "db" when running via Compose
MIGRATION_DATABASE_URL=postgres://event_app_owner:change_me_long_random@db:5432/annual_event
DATABASE_URL=postgres://app_runtime:change_me_long_random_2@db:5432/annual_event
DB_POOL_MIN=2
DB_POOL_MAX=20

# --- Secrets ---
# Random 32+ byte secret used to sign admin session cookies
SESSION_SECRET=change_me_generate_with_openssl_rand_hex_32
# Pepper mixed into every NIC last-4-digit hash (in addition to a per-row salt). Never reuse across environments.
NIC_PEPPER=change_me_generate_with_openssl_rand_hex_32

# --- Big screen access control ---
# Secret tokens required in the screen URL: /screen/raffle?token=... and /screen/vote?token=...
SCREEN_TOKEN_RAFFLE=change_me_generate_with_openssl_rand_hex_16
SCREEN_TOKEN_VOTE=change_me_generate_with_openssl_rand_hex_16
# Comma-separated list of IPs/CIDRs allowed to load the big-screen pages (e.g. venue laptop, admin laptop)
SCREEN_ALLOWED_IPS=127.0.0.1,::1

# --- Load testing (leave empty in normal operation) ---
# Comma-separated IPs exempt from the global rate limiter. Set this to the
# k6 load-testing machine's IP only for the duration of a load test run,
# then clear it — see tests/k6/README.md.
RATE_LIMIT_ALLOWLIST=

# --- Public address (used for the event QR codes) ---
# Fixed public URL of this app, no trailing slash, e.g. https://event.company.com
# The raffle/vote QR codes encode PUBLIC_BASE_URL + /raffle and /vote. Set it
# BEFORE downloading and printing the QR codes, and don't change it afterwards.
PUBLIC_BASE_URL=http://localhost:3000

# --- Deployment (used by Caddy in production) ---
# Subdomain that Caddy will issue an HTTPS certificate for, e.g. event.company.com
DOMAIN=localhost
